# Ignore everything by default
*

# Allow files in root
!app.js
!app.json
!package.json
!package-lock.json
!start.bat
!README.md
!LICENSE.md
!.gitignore

# Allow core folders (and everything recursively inside them)
!bin/
!bin/**
!public/
!public/**
!routes/
!routes/**
!socket/
!socket/**
!views/
!views/**
!wget/
!wget/**
!archiver/
!archiver/**

# Ignore downloads inside public/sites
public/sites/*
!public/sites/.gitkeep
